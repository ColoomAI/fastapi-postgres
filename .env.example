# Postgres connection. The Coloom sandbox auto-injects DATABASE_URL pointing
# at the local Postgres sidecar. For local dev, point at your own
# instance.
#
# Driver suffix matters: SQLAlchemy 2.0 async needs `+asyncpg` at
# runtime. Alembic uses the same URL by stripping the suffix and
# attaching `+psycopg2` (see migrations/env.py) — keep both drivers
# in pyproject.toml.
#
# Example: postgresql+asyncpg://user:pass@localhost:5432/dev
DATABASE_URL=

# Set to "1" when DATABASE_URL targets a managed Postgres provider
# (RDS / Neon / Supabase) that requires TLS. Leave unset for the
# sandbox-local Postgres sidecar.
DATABASE_SSL=

# JWT signing secret. MUST be ≥ 32 chars in production. Generate with:
#   openssl rand -base64 48
# The Coloom sandbox auto-generates and injects one per project.
JWT_SECRET=

# CORS — comma-separated origins (e.g. https://yourapp.com).
# Cookie auth requires CORS allow-credentials, which forbids '*'. Be
# explicit and list every frontend origin that should be able to call
# this API.
CORS_ORIGINS=

# CSRF allowed origins. Comma-separated. If unset, the CSRF middleware
# reuses CORS_ORIGINS (same allowlist works for both 9/10 times).
CSRF_ALLOWED_ORIGINS=

# Cookie scope. Defaults work for same-origin / subdomain.
#   COOKIE_SAMESITE=lax     same-site or via shared eTLD+1
#   COOKIE_SAMESITE=none    cross-site (frontend on Vercel, API on
#                           Coloom sandbox) — REQUIRES https + secure.
COOKIE_SAMESITE=lax
# Leave unset so the cookie binds to the API host only. Set to
# ".example.com" to share across subdomains.
COOKIE_DOMAIN=

LOG_LEVEL=info
NODE_ENV=development
PORT=8080
